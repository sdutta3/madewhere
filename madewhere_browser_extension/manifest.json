{
  "manifest_version": 3,
  "name": "MadeWhere",
  "version": "1.0.0",
  "description": "Estimates which country a product is made in on Amazon.com or similar sites, using the text already rendered on the product page, assumes China as the default when nothing is stated. Not affiliated with Amazon.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": ["*://*.amazon.com/*", "*://*.shopgoodwill.com/*", "*://*.bookshop.org/*", "*://*.instacart.com/*", "*://*.doordash.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*", "*://*.shopgoodwill.com/*", "*://*.bookshop.org/*", "*://*.instacart.com/*", "*://*.doordash.com/*"],
      "js": ["src/countries.js", "src/ner.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Where is this made?",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "madewhere@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
