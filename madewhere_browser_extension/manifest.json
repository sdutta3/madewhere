{
  "manifest_version": 3,
  "name": "MadeWhere",
  "version": "1.0.0",
  "description": "Estimates which country an Amazon.com or similar site product is made in, using the text already rendered on the product page.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["*://*.amazon.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["src/countries.js", "src/ner.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Where is this made?",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "madewhere@example.com",
      "strict_min_version": "128.0"
    }
  }
}
